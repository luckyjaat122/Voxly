# ── LiveKit Cloud (free tier) ────────────────────────────────────
# Get from https://cloud.livekit.io/projects
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini ────────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy__________________________

# ── Vobiz SIP Trunk ─────────────────────────────────────────────
# Get from your Vobiz dashboard
VOBIZ_SIP_HOST=sip.vobiz.in
VOBIZ_SIP_USERNAME=your_username
VOBIZ_SIP_PASSWORD=your_password
VOBIZ_SIP_TRANSPORT=udp
VOBIZ_DID_NUMBERS=+91XXXXXXXXXX

# Set after running: python sip_config.py
VOBIZ_SIP_TRUNK_ID=
